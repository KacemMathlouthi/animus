{
  "name": "@animus/auth",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "auth:generate": "bun --env-file=../../.env better-auth generate --config ./src/auth.ts --output ../db/src/schema/auth.ts -y",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "email:preview": "bun --env-file=../../.env ./scripts/preview-email.ts"
  },
  "dependencies": {
    "@animus/core": "workspace:*",
    "@animus/db": "workspace:*",
    "@better-auth/infra": "^0.4.5",
    "better-auth": "~1.6.22",
    "resend": "^6.12.4"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "vitest": "^3"
  }
}
