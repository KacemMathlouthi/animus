{
  "$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",
  "root": false,
  // The react preset carries ONLY react linter rules — no core rules and no
  // formatter. A nested Biome 2 config does not inherit the repo-root one
  // implicitly, so core must be extended here explicitly or this workspace
  // silently runs on Biome's defaults.
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  // shadcn/ui and ai-elements are vendored upstream code. Formatting them keeps
  // the tree consistent, but re-sorting attributes/classes and enforcing our
  // house style on them is pure churn that makes future upstream re-pulls
  // harder to diff. Correctness, security, a11y and the meaningful suspicious
  // rules stay on.
  "overrides": [
    {
      "includes": ["src/components/ui/**", "src/components/ai-elements/**"],
      "assist": { "enabled": false },
      "linter": {
        "rules": {
          "complexity": "off",
          "nursery": "off",
          "performance": "off",
          "style": "off",
          "suspicious": "off"
        }
      }
    }
  ],
  "linter": {
    "rules": {
      "complexity": {
        // Every hit is `void somePromise()` — the deliberate fire-and-forget
        // marker for a promise we intentionally don't await. Removing it would
        // hide the floating promise rather than fix anything.
        "noVoid": "off"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@animus/core/env": "Server-only env must never be imported in the web app — it carries secrets and reads process.env. Import domain types/schemas from '@animus/core' instead."
            }
          }
        }
      }
    }
  }
}
