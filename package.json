{
  "name": "animus",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.9",
  "description": "Agent that produces narrated, research-grounded Manim explainer videos.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "ultracite fix",
    "check": "ultracite check",
    "knip": "knip",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@types/bun": "latest",
    "knip": "latest",
    "turbo": "latest",
    "typescript": "latest",
    "ultracite": "latest"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
