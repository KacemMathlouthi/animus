{
  "$schema": "https://unjs.io/schema.json",
  "workspaces": {
    ".": {
      "entry": []
    },
    "apps/web": {
      "entry": [
        "index.html",
        "src/components/ui/**",
        "src/components/ai-elements/**",
        "src/components/theme-provider.tsx"
      ],
      "project": "src/**/*.{ts,tsx}",
      "ignoreDependencies": [
        "tailwindcss",
        "tw-animate-css",
        "@fontsource-variable/geist",
        "shadcn"
      ]
    },
    "apps/video": {
      "entry": ["src/index.ts", "remotion.config.ts"],
      "project": "src/**/*.{ts,tsx}",
      "ignoreDependencies": [
        "tailwindcss",
        "tw-animate-css",
        "@fontsource-variable/geist",
        "shadcn",
        "streamdown"
      ]
    },
    "apps/api": {
      "project": "src/**/*.ts"
    },
    "packages/auth": {
      "project": "src/**/*.ts",
      "ignoreDependencies": ["@better-auth/cli"]
    },
    "packages/*": {
      "project": "src/**/*.ts"
    }
  }
}
