{
  "$schema": "https://unjs.io/schema.json",
  "workspaces": {
    ".": {
      "entry": []
    },
    "apps/web": {
      "entry": [
        "index.html",
        "src/components/ui/**",
        "src/components/theme-provider.tsx"
      ],
      "project": "src/**/*.{ts,tsx}",
      "ignoreDependencies": [
        "tailwindcss",
        "tw-animate-css",
        "@fontsource-variable/geist",
        "lucide-react",
        "shadcn"
      ]
    },
    "packages/*": {
      "entry": ["src/index.ts"],
      "project": "src/**/*.ts"
    }
  }
}
