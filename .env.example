# Copy to `.env` and fill in.

# Database
# Matches docker-compose.yml (user:password@host:port/db).
DATABASE_URL=postgres://animus:animus@localhost:5432/animus

# Better Auth
# Secret used to sign session cookies/tokens. 
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-random-string

# Public URL of the API that serves /api/auth/* (where Better Auth lives).
BETTER_AUTH_URL=http://localhost:8787
# Origin of the web app, allowed to call the API with credentials (CORS + cookies).
WEB_ORIGIN=http://localhost:5173

# OAuth providers
# GitHub:  https://github.com/settings/developers  (callback: BETTER_AUTH_URL/api/auth/callback/github)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google:  https://console.cloud.google.com/apis/credentials  (callback: .../api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (magic link)
RESEND_API_KEY=