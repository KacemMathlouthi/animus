# Copy to `.env` and fill in.

# Database
# Matches docker-compose.yml (user:password@host:port/db).
DATABASE_URL=postgres://animus:animus@localhost:5432/animus

# Better Auth
# Secret used to sign session cookies/tokens. 
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-random-string

# Public URL of the API that serves /api/auth/* (where Better Auth lives).
BETTER_AUTH_URL=http://localhost:8787

# Encryption key for BYO provider API keys, stored AES-256-GCM at rest.
# Generate one with: openssl rand -base64 32
ENCRYPTION_KEY=replace-me-with-a-32-byte-base64-key
# Origin of the web app, allowed to call the API with credentials (CORS + cookies).
WEB_ORIGIN=http://localhost:5173

# OAuth providers
# GitHub:  https://github.com/settings/developers  (callback: BETTER_AUTH_URL/api/auth/callback/github)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google:  https://console.cloud.google.com/apis/credentials  (callback: .../api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Better Auth Infrastructure (managed dashboard + analytics) — https://better-auth.com/dashboard
# Optional. When set, the dash() plugin reports to the hosted dashboard.
BETTER_AUTH_API_KEY=

# Amazon Bedrock — powers the free-tier agent (Claude via Bedrock).
# Locally, credentials/region resolve from these AWS_* vars (or the AWS
# credential chain — e.g. an IAM role — in which case omit the keys).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# In DEPLOYED environments use the BEDROCK_* names instead: Vercel owns the
# AWS_* namespace at runtime and silently shadows user-supplied values. The
# app prefers BEDROCK_* when set and falls back to AWS_* for local dev.
# BEDROCK_REGION=us-east-1
# BEDROCK_ACCESS_KEY_ID=
# BEDROCK_SECRET_ACCESS_KEY=
# Bedrock inference-profile id — enable model access in the Bedrock console for
# your region, then set the matching profile id here.
# BEDROCK_MODEL=us.anthropic.claude-opus-4-8

# Exa — powers agent web search and page fetch tools.
EXA_API_KEY=

# Braintrust — LLM observability. When BRAINTRUST_API_KEY is set, the agent's
# AI SDK calls emit OpenTelemetry traces (prompts, completions, token usage,
# tool calls) to Braintrust. Leave blank to disable tracing entirely.
# https://www.braintrust.dev/app/settings/api-keys
BRAINTRUST_API_KEY=
# Project the traces land in (defaults to "animus").
# BRAINTRUST_PROJECT=animus

# ElevenLabs — narration. Injected into the render sandbox so manim-voiceover
# can synthesize speech during render. Required. https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Credits — new accounts start with a $5 free grant (metered turns run on our
# keys). Optional safety cap on TOTAL free-credit spend across all users, in
# whole USD: once exceeded, brand-new accounts are seeded at $0 (existing
# balances untouched). Unset means unlimited free grants.
# CREDITS_GLOBAL_CAP_USD=500

# Daytona — the cloud sandbox the agent writes + renders Manim in.
# https://app.daytona.io/dashboard/keys
DAYTONA_API_KEY=
# Optional region/target (e.g. us, eu).
# DAYTONA_TARGET=

# Cloudflare R2 (S3-compatible) — stores rendered videos; the web streams them
# via short-lived presigned URLs. All four are required.
# Dashboard: Cloudflare > R2 > (bucket) and "Manage R2 API Tokens".
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=animus-videos

# Email (magic link) — https://resend.com/api-keys
# Without a key, magic links are printed to the API console.
RESEND_API_KEY=
# Sender address. The default shared sender only delivers to your own Resend
# account email; set a verified-domain address for real delivery.
RESEND_FROM="animus <onboarding@resend.dev>"
